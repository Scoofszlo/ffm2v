{
  "tabWidth": 2,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "auto",
  "bracketSpacing": true,
  "objectWrap": "preserve",
  "arrowParens": "always",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "^@core/(.*)$",
    "^@repo/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^[./]"
  ]
}
