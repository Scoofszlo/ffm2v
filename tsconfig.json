{
  "compilerOptions": {
    "rootDir": ".",

    // Bundler resolution accepts extensionless import specifiers and mirrors how
    // tsdown/tsx/vitest load files. `nodenext`/`node16` would require every
    // import path to end in `.ts`.
    "module": "esnext",
    "moduleResolution": "bundler",

    "noEmit": true,
    "resolveJsonModule": true,

    // Was inherited from @tsconfig/node20 before this config stopped extending it.
    "target": "es2022",
    "lib": ["es2023"],
    "esModuleInterop": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // @ alias for src directory
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["./src/**/*", "./tests/**/*"],
  "exclude": ["./node_modules/**/*", "./dist/**/*", "./scripts/**/*"]
}
